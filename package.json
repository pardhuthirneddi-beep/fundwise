{
  "name": "fundwise",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,green \"next dev -H 0.0.0.0 -p 3000\" \"python3 -m uvicorn backend.app:app --host 0.0.0.0 --port 8000 --reload\"",
    "build": "FUNDWISE_BUILD=1 next build",
    "start": "python3 -m backend.run",
    "test:api": "python3 -m backend.test_suite",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@xyflow/react": "^12.8.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.14.1",
    "lenis": "^1.3.17",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.24",
    "next": "^15.5.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.3",
    "tailwindcss": "3.4.17",
    "typescript": "^5.8.2"
  }
}
